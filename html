<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday!</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
            margin: 0;
            padding: 0;
            color: #333;
            text-align: center;
        }

        .hero {
            background: rgba(255, 255, 255, 0.8);
            padding: 40px 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .hero h1 {
            color: #ff4757;
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 1.2rem;
            color: #555;
        }

        .content {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .message-card {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }

        .message-card h2 {
            color: #ff6b81;
        }

        button {
            background-color: #ff4757;
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 1rem;
            border-radius: 25px;
            cursor: pointer;
            margin-top: 15px;
            transition: background 0.3s ease;
        }

        button:hover {
            background-color: #ff6b81;
        }

        .gallery-section h2 {
            color: #fff;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.2);
        }

        .gallery {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 40px;
        }

        .photo-card {
            background: white;
            padding: 10px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            width: 250px;
        }

        .photo-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 5px;
        }

        .photo-card p {
            margin: 10px 0 5px;
            font-weight: bold;
            color: #444;
        }

        footer {
            background: rgba(0, 0, 0, 0.1);
            padding: 15px;
            color: #fff;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header class="hero">
        <h1>🎉 Happy Birthday! 🎂</h1>
        <p>Wishing you a day filled with happiness and a year filled with joy.</p>
    </header>

    <!-- Main Content Section -->
    <main class="content">
        <!-- Message Box -->
        <section class="message-card">
            <h2>To Someone Special</h2>
            <p>May all your dreams and wishes come true today and always. Thank you for bringing so much brightness and laughter into our lives!</p>
            <button id="surpriseBtn">Click for a Surprise! 🎁</button>
        </section>

        <!-- Image Gallery Section -->
        <section class="gallery-section">
            <h2>Memories</h2>
            <div class="gallery">
                <div class="photo-card">
                    <!-- Using a built-in data image placeholder. You can replace the long 'data:image...' string with your own image's Base64 code if desired -->
                    <img src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='250' height='200' viewBox='0 0 250 200'><rect width='100%' height='100%' fill='%23ff9a9e'/><text x='50%' y='50%' dominant-baseline='middle' text-anchor='middle' fill='%23fff' font-size='20' font-family='sans-serif'>Your Photo Here</text></svg>" alt="Birthday Memory">
                    <p>Wonderful Moments</p>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer Section -->
    <footer>
        <p>Made with ❤️ for your special day!</p>
    </footer>

    <script>
        document.getElementById('surpriseBtn').addEventListener('click', function() {
            alert('🎉 Surprise! Wishing you the happiest of birthdays today and always! 🎂🎈');
        });
    </script>
</body>
</html>
